# Optional OpenAI-compatible enrichment. The deterministic pipeline works without these.
DAILY_RADAR_LLM_ENABLED=false
DAILY_RADAR_LLM_BASE_URL=https://api.openai.com/v1
DAILY_RADAR_LLM_API_KEY=
DAILY_RADAR_LLM_MODEL=

# Optional runtime overrides.
DAILY_RADAR_CONFIG=config/settings.yaml
DAILY_RADAR_DB=data/daily_radar.db
# Used by cloud deployments to identify this client to arXiv and feed owners.
DAILY_RADAR_USER_AGENT="DailyAIRadar/0.4.0 (contact: name@example.com)"
