# Required for semantic screening. Never commit a real value.
DEEPSEEK_API_KEY=

# Optional budget overrides. The committed defaults are 500k tokens / USD 1 per day.
# A high-volume arXiv day may require raising these; the workflow fails before
# publishing or emailing if the complete two-stage paper screening cannot fit.
DAILY_RADAR_LLM_DAILY_TOKEN_LIMIT=500000
DAILY_RADAR_LLM_DAILY_COST_LIMIT_USD=1.00

# Optional 163 email delivery. The recipient defaults to the same username.
DAILY_RADAR_EMAIL_USERNAME=
DAILY_RADAR_EMAIL_AUTH_CODE=
# DAILY_RADAR_EMAIL_TO=

# Optional runtime overrides.
DAILY_RADAR_CONFIG=config/settings.yaml
DAILY_RADAR_DB=data/daily_radar.db
# Used by cloud deployments to identify this client to arXiv and feed owners.
DAILY_RADAR_USER_AGENT="DailyAIRadar/0.8.0 (contact: name@example.com)"
